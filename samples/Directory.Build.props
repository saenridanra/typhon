<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!--
    Adds Typhon support to every project below this folder.
    Outside this repo the whole block is a single line:  <PackageReference Include="Typhon" Version="0.1.0" />
  -->
  <Import Project="$(TyphonRepoRoot)src/Typhon.Compiler/build/Typhon.props" />
  <ItemGroup>
    <ProjectReference Include="$(TyphonRepoRoot)src/Typhon.Compiler/Typhon.Compiler.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <PropertyGroup>
    <!-- The compiler server caches analyzer DLLs; disable it so edits to the Typhon compiler are picked up on every build. -->
    <UseSharedCompilation>false</UseSharedCompilation>
    <!-- Write the generated C# to obj/…/generated so you can inspect what Typhon produced. -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>
</Project>
