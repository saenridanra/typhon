<Project Sdk="Microsoft.NET.Sdk">

  <!-- A C# app that (1) references a Typhon library and (2) mixes .cs and .ty files in the same project. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(TyphonTargetFramework)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TyphonLib\TyphonLib.csproj" />
  </ItemGroup>

</Project>
