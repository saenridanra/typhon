"""A tour of Typhon: Python syntax, compiled to .NET IL. Run with: typhon run tour.ty"""
from System.Text import StringBuilder
from System.Collections.Generic import Dictionary
from dataclasses import dataclass
import math


@dataclass
class Point:
    x: float
    y: float

    def distance_to(self, other: "Point") -> float:
        return math.sqrt((self.x - other.x) ** 2 + (self.y - other.y) ** 2)


class Shape:
    """Base class: every Python method is virtual in Typhon."""

    def __init__(self, name: str) -> None:
        self.name = name

    def area(self) -> float:
        return 0.0

    def __str__(self) -> str:
        return f"{self.name} with area {self.area():.2f}"


class Circle(Shape):
    def __init__(self, r: float) -> None:
        super().__init__("circle")
        self.r = r

    def area(self) -> float:
        return math.pi * self.r ** 2


class Rect(Shape):
    def __init__(self, w: float, h: float) -> None:
        super().__init__("rect")
        self.w = w
        self.h = h

    def area(self) -> float:
        return self.w * self.h

    @property
    def is_square(self) -> bool:
        return self.w == self.h


class Vector:
    def __init__(self, x: float, y: float) -> None:
        self.x = x
        self.y = y

    def __add__(self, other: "Vector") -> "Vector":
        return Vector(self.x + other.x, self.y + other.y)

    def __mul__(self, k: float) -> "Vector":
        return Vector(self.x * k, self.y * k)

    def __repr__(self) -> str:
        return f"Vector({self.x}, {self.y})"


def fib(n: int) -> int:
    return n if n < 2 else fib(n - 1) + fib(n - 2)


def squares(n: int) -> Iterator[int]:
    for i in range(n):
        yield i * i


def first[T](items: list[T]) -> T:
    return items[0]


def classify(n: int) -> str:
    if n < 0:
        label = "negative"
    elif n == 0:
        label = "zero"
    else:
        label = "positive"
    return label


async def fetch(n: int) -> int:
    await asyncio.sleep(0.01)
    return n * 2


import asyncio
from typing import Iterator

shapes: list[Shape] = [Circle(1.0), Rect(2.0, 3.0), Rect(2.0, 2.0)]
for s in shapes:
    print(s)

total = sum(s.area() for s in shapes)
print(f"total area: {total:.3f}")
print("squares:", [x for x in squares(6) if x % 2 == 0])
print("fib(20) =", fib(20))
print("first:", first(["a", "b"]), classify(-5), classify(0), classify(7))

p = Point(0.0, 0.0)
q = Point(3.0, 4.0)
print(p, "->", q, "distance", p.distance_to(q), "equal?", p == Point(0.0, 0.0))

v = Vector(1.0, 2.0) + Vector(3.0, 4.0) * 2.0
print(v)

words = "the quick brown fox jumps over the lazy dog".split()
counts: dict[str, int] = {}
for w in words:
    counts[w] = counts.get(w, 0) + 1
print("counts:", counts)
print("longest:", max(words, key=lambda w: len(w)), "sorted:", sorted(set(words))[:3])
print("upper/join:", "-".join(w.upper() for w in words[:3]))

sb = StringBuilder()
for i, w in enumerate(words[:3]):
    sb.Append(f"{i}:{w} ")
print(sb.ToString().strip())

lookup = Dictionary[str, int]()
lookup["answer"] = 42
print("dotnet dict:", lookup["answer"], "contains:", "answer" in lookup)

print("python semantics:", 7 / 2, 7 // 2, -7 % 3, 2 ** 10, "ab" * 3, [0] * 3)
print("slices:", words[-1], words[1:3], "hello"[::-1], "hello"[-3:])

try:
    x = int("not a number")
except ValueError as e:
    print("caught ValueError:", type(e).Name)
finally:
    print("finally ran")

a, b = 1, 2
a, b = b, a
print("swapped:", a, b)
print("async:", asyncio.run(fetch(21)))
r = Rect(3.0, 3.0)
print("is square:", r.is_square, isinstance(r, Shape), isinstance(r, Circle))
