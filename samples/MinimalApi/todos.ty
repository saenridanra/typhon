"""The data of the minimal API: plain Typhon classes, serialized to JSON by System.Text.Json."""
from dataclasses import dataclass


@dataclass
class Todo:
    id: int
    title: str
    done: bool


@dataclass
class NewTodo:
    """The body of POST /todos."""
    title: str


class TodoStore:
    """An in-memory store, registered as a singleton service."""

    def __init__(self) -> None:
        self.todos: list[Todo] = []
        self.next_id = 1

    def all(self) -> list[Todo]:
        return self.todos

    def find(self, id: int) -> Todo | None:
        for todo in self.todos:
            if todo.id == id:
                return todo
        return None

    def add(self, title: str) -> Todo:
        todo = Todo(self.next_id, title, False)
        self.next_id += 1
        self.todos.append(todo)
        return todo

    def complete(self, id: int) -> bool:
        todo = self.find(id)
        if todo is None:
            return False
        todo.done = True
        return True
