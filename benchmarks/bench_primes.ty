"""Sieve of Eratosthenes: list indexing and integer loops."""
import time


def sieve(n: int) -> int:
    is_prime = [True] * (n + 1)
    is_prime[0] = False
    is_prime[1] = False
    i = 2
    while i * i <= n:
        if is_prime[i]:
            for j in range(i * i, n + 1, i):
                is_prime[j] = False
        i += 1
    return sum(1 for p in is_prime if p)


if __name__ == "__main__":
    t0 = time.perf_counter()
    count = 0
    for _ in range(5):
        count = sieve(5_000_000)
    elapsed = time.perf_counter() - t0
    print(f"primes: {count} primes below 5,000,000 (5 runs)")
    print(f"TIME primes {elapsed * 1000:.1f} ms")
