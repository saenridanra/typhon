"""Spectral norm (Computer Language Benchmarks Game): nested loops, many small function calls, float math."""
import math
import time


def eval_a(i: int, j: int) -> float:
    return 1.0 / ((i + j) * (i + j + 1) // 2 + i + 1)


def mul_av(n: int, v: list[float], out: list[float]) -> None:
    for i in range(n):
        s = 0.0
        for j in range(n):
            s += eval_a(i, j) * v[j]
        out[i] = s


def mul_atv(n: int, v: list[float], out: list[float]) -> None:
    for i in range(n):
        s = 0.0
        for j in range(n):
            s += eval_a(j, i) * v[j]
        out[i] = s


def mul_atav(n: int, v: list[float], out: list[float], tmp: list[float]) -> None:
    mul_av(n, v, tmp)
    mul_atv(n, tmp, out)


def spectral_norm(n: int) -> float:
    u = [1.0] * n
    v = [0.0] * n
    tmp = [0.0] * n
    for _ in range(10):
        mul_atav(n, u, v, tmp)
        mul_atav(n, v, u, tmp)
    vbv = 0.0
    vv = 0.0
    for i in range(n):
        vbv += u[i] * v[i]
        vv += v[i] * v[i]
    return math.sqrt(vbv / vv)


if __name__ == "__main__":
    t0 = time.perf_counter()
    result = spectral_norm(400)
    elapsed = time.perf_counter() - t0
    print(f"spectralnorm: {result:.9f}")
    print(f"TIME spectralnorm {elapsed * 1000:.1f} ms")
