"""numpy: linear algebra on a 300x300 system — solve and inverse (NumPy uses LAPACK)."""
import time
import numpy as np


def linalg(n: int, reps: int) -> float:
    a = np.eye(n) * float(n) + np.ones((n, n))
    b = np.arange(n) / float(n)
    total = 0.0
    for _ in range(reps):
        x = np.linalg.solve(a, b)
        inv = np.linalg.inv(a)
        total += x.sum() + np.trace(inv)
    return total


if __name__ == "__main__":
    t0 = time.perf_counter()
    r = linalg(300, 10)
    elapsed = time.perf_counter() - t0
    print(f"np_linalg: {r:.9e}")
    print(f"TIME np_linalg {elapsed * 1000:.1f} ms")
