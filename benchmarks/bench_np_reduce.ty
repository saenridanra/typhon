"""numpy: reductions along axes on a 2000x2000 matrix (sum, mean, std, max)."""
import time
import numpy as np


#pythran export reduce(int)
def reduce(reps: int) -> float:
    a = np.arange(4_000_000).reshape(2000, 2000) / 4_000_000.0
    total = 0.0
    for _ in range(reps):
        s0 = a.sum(axis=0)
        s1 = a.mean(axis=1)
        total += s0.sum() + s1.sum() + a.std() + a.max()
    return total


if __name__ == "__main__":
    t0 = time.perf_counter()
    r = reduce(20)
    elapsed = time.perf_counter() - t0
    print(f"np_reduce: {r:.6e}")
    print(f"TIME np_reduce {elapsed * 1000:.1f} ms")
