"""Problem: estimate pi from 5M quasi-random points (golden-ratio sequence, deterministic) — plain Python loop."""
import time


#pythran export estimate_pi(int)
def estimate_pi(n: int) -> float:
    inside = 0
    for i in range(n):
        x = (i * 0.6180339887498949) % 1.0
        y = (i * 0.7548776662466927) % 1.0
        if x * x + y * y <= 1.0:
            inside += 1
    return 4.0 * inside / n


if __name__ == "__main__":
    t0 = time.perf_counter()
    pi = estimate_pi(5_000_000)
    elapsed = time.perf_counter() - t0
    print(f"pi: {pi:.7f}")
    print(f"TIME pi {elapsed * 1000:.1f} ms")
