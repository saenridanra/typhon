"""Problem: sum of squares (dot product) of 10M floats — written as a plain Python loop."""
import time


def sum_squares(xs: list[float]) -> float:
    s = 0.0
    for x in xs:
        s += x * x
    return s


if __name__ == "__main__":
    n = 10_000_000
    xs = [i / n for i in range(n)]
    t0 = time.perf_counter()
    r = sum_squares(xs)
    elapsed = time.perf_counter() - t0
    print(f"dot: {r:.6e}")
    print(f"TIME dot {elapsed * 1000:.1f} ms")
