"""Problem: sum of all pairwise distances between 1500 points (2.25M pairs) — written as plain Python loops."""
import math
import time


def pairwise(xs: list[float], ys: list[float]) -> float:
    n = len(xs)
    total = 0.0
    for i in range(n):
        xi = xs[i]
        yi = ys[i]
        for j in range(n):
            dx = xi - xs[j]
            dy = yi - ys[j]
            total += math.sqrt(dx * dx + dy * dy)
    return total


if __name__ == "__main__":
    n = 1500
    xs = [i / n for i in range(n)]
    ys = [math.sin(x * 10.0) for x in xs]
    t0 = time.perf_counter()
    r = pairwise(xs, ys)
    elapsed = time.perf_counter() - t0
    print(f"pairwise: {r:.6e}")
    print(f"TIME pairwise {elapsed * 1000:.1f} ms")
