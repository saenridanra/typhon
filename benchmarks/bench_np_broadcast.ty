"""numpy: broadcasting — all pairwise distances between 2000 points ((n,1) - (1,n) gives an n x n matrix)."""
import time
import numpy as np


def pairwise(n: int, reps: int) -> float:
    xs = np.linspace(0.0, 1.0, n)
    ys = np.sin(xs * 10.0)
    total = 0.0
    for _ in range(reps):
        dx = xs.reshape(n, 1) - xs.reshape(1, n)
        dy = ys.reshape(n, 1) - ys.reshape(1, n)
        d = np.sqrt(dx * dx + dy * dy)
        total += d.sum()
    return total


if __name__ == "__main__":
    t0 = time.perf_counter()
    r = pairwise(2000, 5)
    elapsed = time.perf_counter() - t0
    print(f"np_broadcast: {r:.6e}")
    print(f"TIME np_broadcast {elapsed * 1000:.1f} ms")
