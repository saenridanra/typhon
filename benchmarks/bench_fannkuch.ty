"""Fannkuch-redux (Computer Language Benchmarks Game): integer list manipulation, permutations, swaps."""
import time


def fannkuch(n: int) -> tuple[int, int]:
    perm1 = list(range(n))
    count = [0] * n
    max_flips = 0
    checksum = 0
    r = n
    perm_count = 0
    while True:
        while r != 1:
            count[r - 1] = r
            r -= 1
        perm = perm1[:]
        flips = 0
        k = perm[0]
        while k != 0:
            i = 0
            j = k
            while i < j:
                perm[i], perm[j] = perm[j], perm[i]
                i += 1
                j -= 1
            flips += 1
            k = perm[0]
        max_flips = max(max_flips, flips)
        checksum += flips if perm_count % 2 == 0 else -flips
        while True:
            if r == n:
                return checksum, max_flips
            perm0 = perm1[0]
            for i in range(r):
                perm1[i] = perm1[i + 1]
            perm1[r] = perm0
            count[r] -= 1
            if count[r] > 0:
                break
            r += 1
        perm_count += 1


if __name__ == "__main__":
    t0 = time.perf_counter()
    checksum, flips = fannkuch(9)
    elapsed = time.perf_counter() - t0
    print(f"fannkuch: checksum {checksum}, max flips {flips}")
    print(f"TIME fannkuch {elapsed * 1000:.1f} ms")
