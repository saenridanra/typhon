"""Conformance: Python ints beyond 32 bits (Typhon's int is a 64-bit long; beyond 64 bits see int_overflow.ty)."""

import math


def factorial(n: int) -> int:
    return 1 if n < 2 else n * factorial(n - 1)


def collatz_peak(n: int) -> int:
    peak = n
    while n != 1:
        n = n // 2 if n % 2 == 0 else 3 * n + 1
        peak = max(peak, n)
    return peak


def power_mod(base, exp, mod):
    # unannotated: parameter types are inferred from the call
    result = 1
    base %= mod
    while exp > 0:
        if exp & 1:
            result = result * base % mod
        base = base * base % mod
        exp >>= 1
    return result


class Counter:
    def __init__(self) -> None:
        self.total = 0

    def add(self, n: int) -> None:
        self.total += n


# sums and products that leave the 32-bit range
total = 0
for i in range(100000):
    total += i
print(total, sum(range(100000)), sum([2 ** 40] * 3))
print(factorial(13), factorial(20), 46341 * 46341, 123456789 * 31 + 7)
print(2 ** 40, 2 ** 62, -(2 ** 62), 10 ** 18, 3 ** 39)

# shifts and bit operations
print(1 << 40, 1 << 62, (1 << 62) >> 61, -17 >> 2, -1 >> 70, 5 >> 64)
print(0xFFFFFFFFFF & 0x0F0F0F0F0F, (1 << 40) | 1, (1 << 35) ^ (1 << 34), ~(2 ** 40))
x = 3
x <<= 33
print(x, x >> 3)

# classic integer algorithms
a, b = 0, 1
for _ in range(90):
    a, b = b, a + b
print("fib(90) =", a)
print("collatz peak of 837799:", collatz_peak(837799))
print("pow mod:", power_mod(2, 10 ** 18, 1_000_000_007), power_mod(7, 123456789, 998244353))
seed = 42
for _ in range(5):
    seed = (seed * 1103515245 + 12345) % 2 ** 31
print("lcg:", seed)

# division and modulo keep Python's floor semantics on big values
n = -(10 ** 15) - 7
print(n // 10, n % 10, divmod(n, 1000), divmod(10 ** 12, 7), abs(n), -n // 3)

# conversions and formatting
big = 9_007_199_254_740_993
print(big, str(big), repr(big), int("12345678901234"), int(1e15), int(-2.5e12))
print(f"{2 ** 40:,} {2 ** 40:_} {big:x} {big:#X} {2 ** 33:b} {2 ** 33:o} {big:>22d}|")
print(f"{2 ** 40:e} {2 ** 40:.3e} {12345678:g} {5:g}", format(2 ** 50, ","))
print(hex(2 ** 40), bin(2 ** 33), oct(2 ** 33), hex(-(2 ** 40)))
print(round(1234567890123.5), round(2.5e12), round(1e15 + 0.25))

# math with big ints
print(math.factorial(20), math.gcd(2 ** 40, 6 ** 20), math.isqrt(10 ** 18), math.isqrt(2 ** 62 - 1))
print(math.comb(60, 30), math.perm(20, 10), math.floor(1e12 + 0.7), math.ceil(-1e12 - 0.7), math.lcm(2 ** 20, 3 ** 20))

# containers, ranges and objects holding big ints
xs = [0] * 3
xs[1] += 2 ** 40
xs.append(2 ** 50)
print(xs, len(xs), max(xs), min(xs), sorted([2 ** 41, 5, 2 ** 40]))
d = {2 ** 40: "a", 7: "b"}
print(d[2 ** 40], 2 ** 40 in d, sorted(d))
print(list(range(10 ** 10, 10 ** 10 + 3)), list(range(2 ** 40, 2 ** 40 - 7, -3)))
for i, v in enumerate(["x", "y"], 2 ** 40):
    print(i, v)
c = Counter()
for k in range(1, 4):
    c.add(10 ** 12 * k)
print(c.total)
limit: int = 2 ** 40
steps = 0
while limit > 1:
    limit //= 3
    steps += 1
print(steps, 2 ** 40 > 2 ** 39 > 0, 10 ** 15 == 1000000000000000)
