"""Conformance: list, dict, set, tuple operations and the builtins that work on them."""

xs = [3, 1, 2]
xs.append(5)
xs.extend([9, 7])
xs.insert(1, 8)
print(xs, len(xs), xs[0], xs[-1], xs[1:3], xs[::-1])
xs.sort()
print(xs, xs.pop(), xs.pop(0), xs)
xs.remove(5)
xs.reverse()
print(xs, xs.index(7), xs.count(2), 7 in xs, 4 not in xs)
ys = xs.copy()
ys.clear()
print(ys, xs + [100], [0] * 4, [1, 2] * 2)

d = {"b": 2, "a": 1}
d["c"] = 3
print(d, len(d), d["a"], d.get("z", 0), "a" in d, list(d.keys()), list(d.values()))
print(d.setdefault("e", 5), d.pop("b"), d, d.setdefault("a", 9))
for k, v in d.items():
    print(k, v, end="; ")
print()
d2 = {k: v * 10 for k, v in d.items() if v > 1}
print(d2)

s = {3, 1, 2}
s.add(4)
s.discard(1)
print(sorted(s), 2 in s, len(s))
t = (1, "two", 3.0)
a, b, c = t
print(t, a, b, c, len(t))

nested = [[1, 2], [3, 4]]
print(nested, [x for row in nested for x in row], {x % 3 for x in range(10)})
print(list(enumerate(["a", "b"])), list(zip([1, 2, 3], "ab")), list(reversed([1, 2, 3])))
words = ["banana", "Apple", "cherry", "apple"]
print(sorted(words), sorted(words, key=len), sorted(words, key=lambda w: w.lower(), reverse=True))
print(min(words), max(words, key=len), sum(len(w) for w in words), any(w.startswith("c") for w in words), all(len(w) > 3 for w in words))
gen = (i * i for i in range(5))
print(list(gen))
print(list(range(10, 0, -3)), list(range(0)), list(map(str, [1, 2])), list(filter(lambda n: n % 2 == 0, range(7))))
empty_list: list[int] = []
empty_dict: dict[str, int] = {}
print(empty_list, empty_dict, ())
