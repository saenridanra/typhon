"""Conformance (known difference): beyond 64 bits CPython switches to arbitrary precision, Typhon raises OverflowError."""


def factorial(n: int) -> int:
    return 1 if n < 2 else n * factorial(n - 1)


print(factorial(25))
print(2 ** 64, 1 << 100)
