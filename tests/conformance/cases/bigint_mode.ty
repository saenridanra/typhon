"""Conformance: big-int mode (the comment above, typhon --bigint, or TyphonIntMode=bigint): ints are unbounded, like Python's."""

import math
from functools import cache


def factorial(n: int) -> int:
    result = 1
    for i in range(2, n + 1):
        result *= i
    return result


def fib(n):
    a, b = 0, 1
    for _ in range(n):
        a, b = b, a + b
    return a


@cache
def partitions(n: int, k: int = 1) -> int:
    if n == 0:
        return 1
    return sum(partitions(n - i, i) for i in range(k, n + 1))


def digit_sum(n: int) -> int:
    total = 0
    while n > 0:
        n, d = divmod(n, 10)
        total += d
    return total


def collatz_steps(n: int) -> int:
    steps = 0
    while n != 1:
        n = n // 2 if n % 2 == 0 else 3 * n + 1
        steps += 1
    return steps


# arithmetic beyond 64 bits
print(factorial(30), fib(100), 2**100, -(2**70) // 3, -(2**70) % 7, 10**20 + 1)
print(digit_sum(2**1000), len(str(factorial(100))), collatz_steps(27), partitions(60))
big = 12345678901234567890123
print(big * big, big - 2**64, big // 10**10, big % 1000, big << 3, big >> 40, big & 0xFFFF, -big)
print(pow(3, 200, 10**9 + 7), pow(2, 64) - 1, math.factorial(25), math.comb(100, 50), math.gcd(2**80, 6**30), math.isqrt(10**30))

# 64-bit counts (len, range counters) mix with ints
words = ["alpha", "beta", "gamma"]
n = len(words)
for i in range(n):
    print(i, words[i], i * 2**62, n**30)
squares = [i * i for i in range(5)]
squares.append(2**65)
print(squares, sum(squares), max(squares), min(squares), sorted(squares, reverse=True)[0])

# ints as positions, counts and repetitions
k = 2
print(words[k], words[-k], words[k - 1:], [0] * k, "ab" * k, list(range(k, 5)), sum(range(10**6)))
counts = {}
for w in words:
    counts[len(w)] = counts.get(len(w), 0) + 2**64
print(counts, abs(-big), divmod(big, 97), round(big), hex(2**70), bin(5), (2**70).bit_length())

# conversions and comparisons with floats
print(int("123456789012345678901234567890") + 1, int("ff", 16), int(3.99), int(-2.5), float(2**70), 2**70 > 1e20, 3 == 3.0)
print(big / 2, 7 / 2, 2**60 > 1.5e18, 1e30 > 10**29, f"{big:,}", f"{2**64:x}", str(-5))
print(math.factorial(20) == factorial(20), isinstance(big, int), [factorial(i) for i in range(18, 23)])
