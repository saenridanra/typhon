"""Conformance: numbers and Python operator semantics."""

print(7 / 2, 7 // 2, -7 // 2, 7 % 3, -7 % 3, 7 % -3, 2 ** 10, 2 ** 0.5)
print(divmod(17, 5), divmod(-17, 5))
print(round(2.5), round(3.5), round(-2.5), round(3.14159, 2), round(2.675, 2))
print(abs(-3), abs(-2.5), min(3, 1, 2), max(3, 1, 2), min([4, 2, 8]), max([4.5, 2.25]))
print(int("42"), int("-17"), int(3.99), int(-3.99), float("2.5"), float("1e3"), float("inf"), float("-inf"))
print(0.1 + 0.2, 1.0, 1e16, 1e-5, 1.5e300, 123456789.0, 2.0 ** 60, 1 / 3)
print(hex(255), bin(10), oct(8), hex(-255))
print(1 < 2 < 3, 3 < 2 < 1, 1 == 1.0, 2 != 3)
print(True and False, True or False, not True, not 0, not [], bool(0), bool(""), bool("x"), bool([1]))

x = 10
x += 5
x -= 3
x *= 2
x //= 5
print(x)
y = 7.0
y /= 2
y **= 2
print(y)
print(7 % 2.5, -7.5 % 2, 10 // 3.0)
print(sum([1, 2, 3]), sum([0.5, 0.25]), sum(range(10)))
print(2 ** 30, -(2 ** 30), 2 ** 3 ** 2, -2 ** 2)  # int is 32-bit in Typhon (documented), so stay below 2 ** 31
