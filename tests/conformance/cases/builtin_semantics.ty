"""Conformance: semantics of Python's built-in types (==, ordering, bool as int, sets, str elements, tuples, iteration)."""


def squares(n: int):
    for i in range(n):
        yield i * i


# == compares contents, ordering is lexicographic, sets order by inclusion
a = [1, 2, 3]
b = [1, 2, 3]
print(a == b, a != b, a is b, [1, [2, 3]] == [1, [2, 3]], {"k": [1]} == {"k": [1]}, {1, 2} == {2, 1})
print((1, 2) == (1, 2), (1, "x") != (1, "y"), 1 == 1.0, True == 1, "a" == "a", [1] == (1,))
print([1, 2] < [1, 3], [2] > [1, 9], (1, 2) <= (1, 2), "apple" < "banana", "Z" < "a", [] < [0])
print({1} < {1, 2}, {1, 2} <= {1, 2}, {1, 2} > {1}, {3} <= {1, 2})
print(max(["pear", "apple", "fig"]), min((3, "c"), (1, "z"), (1, "a")), sorted([(2, "b"), (1, "z"), (2, "a")]))

# bool is an int
count = 0
for n in range(10):
    count += n % 3 == 0
print(count, True + True, sum([True, False, True]), -True, True * 7)

# set algebra, in-place updates, dict merge
s = {1, 2, 3, 4}
t = {3, 4, 5}
print(sorted(s - t), sorted(s | t), sorted(s & t), sorted(s ^ t))
s -= {1}
s |= {10, 11}
s &= {2, 3, 10, 99}
print(sorted(s), sorted(s.union([7], [8])), sorted(s.difference({2})), s.isdisjoint({42}), s.issuperset({2}))
u = {5, 6}
u.update([7], {8})
u.difference_update({5})
u.discard(100)
print(sorted(u), len(u), 6 in u, sorted(u.symmetric_difference({6, 9})))
d1 = {"a": 1, "b": 2}
d2 = {"b": 3, "c": 4}
print(d1 | d2, d1.pop("x", -1), d1.pop("a"), d1, dict.fromkeys(["p", "q"], 0))
d1 |= {"z": 26}
print(d1, d1.popitem(), d1)

# a str's elements are strs
word = "typhon"
print(word[0] + word[-1], word[2] * 3, [c.upper() for c in word], sorted(word), list(reversed(word)), max(word))
letters = {c: i for i, c in enumerate("abc")}
print(letters["b"], [letters[c] for c in "cab"], "".join(c for c in word if c in "aeiouy"), set("aab") == {"a", "b"})
print(word.swapcase(), "a-b-c".rsplit("-", 1), "key=value".partition("="), "x.y".rpartition("."), "Title Case".istitle())
print("tab\there".expandtabs(4), "abcabc".replace("b", "B", 1), "prefix-body".removeprefix("prefix-"), "ab".startswith(("x", "a")))
print("line1\nline2\r\n".splitlines(True), "12".isdecimal(), "x1".isidentifier(), "abc".find("c", 1), "a,b".split(",", maxsplit=1))

# tuples are sequences
point = (3, 4, 5)
print(point[0], point[-1], len(point), list(point), 4 in point, 9 not in point, sum(point), [x * 2 for x in point])
for x in (10, 20):
    print("tuple item", x)
seen = {(1, 2), (1, 2), (2, 1)}
grid = {(0, 0): "origin", (1, 2): "point"}
print(len(seen), grid[(1, 2)], sorted(seen), tuple([3, 1]), tuple("ab"), (1, 2) + (3,))

# iteration protocol: lists iterate by position, iterators keep their place, generators are iterators
xs = [1, 2, 3]
for x in xs:
    if x < 3:
        xs.append(x * 10)
print(xs)
ys = [1, 2, 3]
for i, y in enumerate(ys):
    ys[i] = y * y
print(ys)
it = iter([5, 6, 7])
print(next(it), next(it), list(it), next(iter([]), "empty"))
gen = squares(5)
print(next(gen), next(gen), next(gen))

# numbers
print(pow(3, 200, 1000007), pow(2, -1, 7), (255).bit_length(), (-5).bit_length(), (7).bit_count())
print((2.0).is_integer(), (2.5).is_integer(), (0.75).as_integer_ratio(), divmod(-7, 2), round(2.5), round(3.5))
