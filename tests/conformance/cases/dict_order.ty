"""Conformance: a dict keeps insertion order even when keys are deleted and new ones are added afterwards."""

d = {"a": 1, "b": 2, "c": 3}
del d["a"]
d["z"] = 26
print(d, list(d))
d.pop("c")
d["y"] = 25
print(d)
