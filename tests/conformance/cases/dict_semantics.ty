"""Conformance: dict behaviour that differs from .NET's Dictionary (iteration yields keys, get() returns None)."""

d = {"b": 2, "a": 1, "c": 3}
for k in d:
    print(k, end=" ")
print()
print(sorted(d), list(d), len(d))
print(d.get("missing"))
